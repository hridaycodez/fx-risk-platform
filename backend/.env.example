# Server
PORT=4000
NODE_ENV=production

# MongoDB (MongoDB Atlas)
MONGO_URI=your_mongodb_connection_string

# JWT Secret
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Python ML Engine (internal docker service name)
ML_ENGINE_URL=http://ml-engine:8000

# Frankfurter FX Rate API
FX_API_BASE=https://api.frankfurter.app
FX_CACHE_TTL_SECONDS=30

# Supported Currencies
SUPPORTED_CURRENCIES=USD,GBP,INR,AED,JPY,CHF
BASE_CURRENCY=EUR

# CORS Origin (allowed frontend domain or * in production)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
